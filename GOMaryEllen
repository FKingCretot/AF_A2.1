  .pst{margin:0 0 12px;break-inside:avoid}
  .pst h3{font-size:14pt;margin-bottom:2px}.pst h3 small{font:400 8.5pt 'Inter';color:var(--muted)}
  .pst p{margin:0;font-size:12pt;line-height:1.6}
  .g{color:var(--c);font-weight:600}
  .pslot{border-bottom:1px solid var(--gold);padding:0 3px}.pslot small{color:var(--muted);font-size:8pt}
  .plegend{font-size:8.5pt;margin:0 0 12px;display:flex;flex-wrap:wrap;gap:4px 12px}
  .plegend span::before{content:"■ ";color:var(--c)}
  .pk{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;margin-bottom:12px}
  .pk div{border:1px solid var(--line);border-radius:8px;padding:7px 10px;break-inside:avoid}
  .pk b{font-size:10.5pt;color:var(--navy)}.pk ul{margin:3px 0 0;padding-left:16px;font-size:9.5pt}
  .pt{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}
  .pt div{border-left:3px solid var(--c);padding:2px 8px;font-size:9.3pt;break-inside:avoid}.pt b{color:var(--c)}
  .memo{display:flex;flex-direction:column;gap:5mm;margin-top:6mm}
  .memo div{border:2px solid var(--navy);border-radius:10px;padding:5mm 6mm;display:flex;align-items:center;gap:6mm}
  .memo .n{font:900 26pt 'Playfair Display';color:var(--gold)}
  .memo .t{font:700 19pt 'Playfair Display';color:var(--navy)}
  .memo .e{font-size:24pt}
  .memo-help{margin-top:6mm;font-size:11pt;border-top:1px dashed var(--line);padding-top:4mm}
  .lines{margin-top:4mm;font-size:9pt;color:var(--muted)}
  .lines div{border-bottom:1px solid #bbb;height:7mm}
}
</style></head>
