<style>
:root{--bg:#f2f0eb;--card:#fff;--navy:#1c2b45;--navy-soft:#33455f;--navy-deep:#111c30;--gold:#b8924a;--gold-light:#e7d7b5;
--text:#2c2c2c;--muted:#6b6b6b;--line:#e6e2d8;--acc:#9c4a34;
--c-pc:#1f4e8c;--c-et:#7a3f8f;--c-imp:#167a74;--c-tps:#a8781f;--c-neg:#a23b2a;--c-yen:#2f7d3b;--c-fut:#c2536f;}
*{box-sizing:border-box}html,body{margin:0}
body{background:var(--bg);color:var(--text);font-family:'Inter',system-ui,sans-serif;line-height:1.6}
h1,h2,h3{font-family:'Playfair Display',serif;color:var(--navy);margin:0}
.wrap{max-width:900px;margin:0 auto;padding:0 20px}
.hero{background:radial-gradient(circle at 12% 20%,rgba(201,162,74,.22),transparent 40%),radial-gradient(circle at 88% 80%,rgba(201,162,74,.16),transparent 45%),linear-gradient(160deg,var(--navy-deep),var(--navy) 55%,var(--navy-soft));color:#fff;padding:22px 0 46px}
.hero .top{display:flex;justify-content:space-between;align-items:center;margin-bottom:34px}
.hero .top img{height:34px}.hero .top span{font-size:12px;color:var(--gold-light);letter-spacing:.06em;text-transform:uppercase}
.hero .eyebrow{color:var(--gold-light);font-size:13px;letter-spacing:.08em;text-transform:uppercase;font-weight:700}
.hero h1{color:#fff;font-size:clamp(2rem,6vw,3.2rem);line-height:1.1;margin:6px 0 4px}
.hero h1 em{color:var(--gold-light);font-style:normal}
.hero .tag{font-family:'Playfair Display',serif;font-style:italic;font-size:1.2rem;color:var(--gold-light)}
.note{margin-top:22px;background:rgba(255,255,255,.08);border:1px solid rgba(231,215,181,.3);border-radius:14px;padding:14px 18px;font-size:.98rem}
.note i{display:block;color:var(--gold-light);font-size:.86rem;margin-top:4px}
.bar{position:sticky;top:0;z-index:20;background:rgba(242,240,235,.95);backdrop-filter:blur(6px);border-bottom:1px solid var(--line)}
.bar .wrap{display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between;padding-top:10px;padding-bottom:10px}
.seg{display:flex;background:#fff;border:1.5px solid var(--navy);border-radius:30px;overflow:hidden}
.seg button{border:none;background:none;padding:8px 14px;font:600 13px 'Inter';color:var(--navy);cursor:pointer}
.seg button.on{background:var(--navy);color:#fff}
.seg button small{display:block;font-weight:500;font-size:10px;opacity:.75}
.tools{display:flex;gap:10px;align-items:center}
.pill{border:1.5px solid var(--gold);background:#fff;color:var(--navy);border-radius:30px;padding:8px 14px;font:600 13px 'Inter';cursor:pointer}
.pill.on{background:var(--gold);color:#fff}
.chrono{font:700 15px 'Inter';color:var(--navy);min-width:52px;text-align:center;font-variant-numeric:tabular-nums}
.chrono.over{color:var(--c-neg)}
section{margin:34px 0}
.sec-title{font-size:1.5rem;margin-bottom:4px}.sec-sub{color:var(--muted);font-style:italic;margin:0 0 16px}
.plan{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
.plan div{background:#fff;border-radius:12px;padding:14px 16px;box-shadow:0 2px 8px rgba(28,43,69,.06);font-size:.92rem}
.plan b{display:block;color:var(--gold);font-size:12px;letter-spacing:.05em;text-transform:uppercase}
.plan i{color:var(--muted);font-size:.82rem;display:block;margin-top:4px}
.legend{display:none;flex-wrap:wrap;gap:6px 14px;font-size:12.5px;margin:0 0 14px}
body.gram .legend{display:flex}
.legend span::before{content:"";display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px;background:var(--c)}
.step{background:#fff;border-radius:16px;box-shadow:0 2px 12px rgba(28,43,69,.07);margin-bottom:16px;overflow:hidden;border-left:5px solid var(--acc)}
.step header{display:flex;align-items:center;gap:14px;padding:16px 20px 6px}
.step .num{font:900 1.8rem 'Playfair Display';color:var(--gold);width:28px}
.step .ic{font-size:1.6rem}
.step h3{font-size:1.25rem;flex:1}
.step .min{font-size:12px;color:var(--muted);white-space:nowrap}
.spd{display:flex;align-items:center;gap:2px;background:#fff;border:1.5px solid var(--line);border-radius:30px;padding:3px 4px 3px 10px;font-size:13px}
.spd button{border:none;background:none;border-radius:20px;padding:5px 9px;font:600 12px 'Inter';color:var(--navy);cursor:pointer}
.spd button.on{background:var(--navy);color:#fff}
.listen.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.listen{border:1px solid var(--line);background:#faf8f3;border-radius:20px;padding:5px 11px;font:600 12px 'Inter';color:var(--navy);cursor:pointer}
.body{padding:6px 22px 20px 62px}
.l1,.l2,.l3{display:none}
body.lv1 .l1,body.lv2 .l2,body.lv3 .l3{display:block}
.l1{font-size:1.12rem;line-height:1.85}
.g{border-radius:4px}
body.gram .g{color:var(--c);font-weight:600;background:color-mix(in srgb,var(--c) 9%,transparent);padding:0 1px}
.pc{--c:var(--c-pc)}.et{--c:var(--c-et)}.imp{--c:var(--c-imp)}.tps{--c:var(--c-tps)}.neg{--c:var(--c-neg)}.yen{--c:var(--c-yen)}.fut{--c:var(--c-fut)}
.li{color:var(--c-neg);font-weight:700}
.slot{border-bottom:2px dashed var(--gold);background:#fbf5e6;padding:0 4px;border-radius:3px;outline:none;cursor:text}
.slot:focus{background:#f4e6c4}
.slot::after{content:" ✎";font-size:.75em;color:var(--gold)}
.l2 ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px}
.l2 li{background:#f6f3ec;border:1px solid var(--line);border-radius:22px;padding:6px 14px;font-size:1.02rem}
.l3 p{margin:4px 0 6px;font:700 1.55rem 'Playfair Display';color:var(--navy)}
.hint{font-size:.85rem;color:var(--muted);font-style:italic;margin:-4px 0 14px}
.box{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:12px}
.tool{background:#fff;border-radius:12px;padding:14px 16px;border-top:4px solid var(--c);box-shadow:0 2px 8px rgba(28,43,69,.06)}
.tool h4{margin:0 0 4px;font-size:.98rem;color:var(--c)}.tool p{margin:0;font-size:.95rem}
.tool small{display:block;color:var(--muted);font-size:11.5px;margin-top:6px}
.help{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px}
.help div{background:#fff;border-radius:12px;padding:14px 18px;box-shadow:0 2px 8px rgba(28,43,69,.06)}
.help b{color:var(--gold);font-size:12px;text-transform:uppercase;letter-spacing:.05em}
.help p{margin:6px 0 0;font-size:1.02rem}.help i{color:var(--muted);font-size:.85rem}
footer{text-align:center;color:var(--muted);font-size:12px;padding:30px 0 50px}
#print{display:none}
@media (max-width:600px){.body{padding:4px 18px 18px}.step header{flex-wrap:wrap}.seg button{padding:7px 9px}}
